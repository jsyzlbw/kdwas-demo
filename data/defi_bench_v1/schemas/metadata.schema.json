{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "protocol",
    "name",
    "category",
    "supported_assets",
    "supported_markets",
    "supported_actions"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "supported_assets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supported_markets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supported_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "protocol",
    "tools"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "description",
          "parameters",
          "returns"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "read",
              "write"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object"
          },
          "returns": {
            "type": "object"
          }
        }
      }
    }
  }
}
